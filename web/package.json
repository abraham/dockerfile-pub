{
  "name": "dockerfile-pub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "lint:js": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"../**/*.md\" \"#../web/node_modules\"",
    "typecheck": "tsc",
    "size": "node scripts/check-size.ts",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore",
    "test:features": "cucumber-js"
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "prettier-plugin-gherkin": "^4.0.0",
    "puppeteer": "^25.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "^10.0.0"
    }
  }
}
